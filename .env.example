# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:AAAA-your-bot-token-here

# Get from https://console.groq.com  (API Keys section)
GROQ_API_KEY=gsk_your_groq_key_here

# Optional: override the default Groq model
# GROQ_MODEL=openai/gpt-oss-120b

# Recommended: a random secret string you also set on the Telegram webhook,
# so only Telegram can trigger your bot. Generate with: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=

# --- Required for user list, conversation memory, and the admin panel ---
# Create a free "KV" database in Vercel: Storage tab -> Create Database -> KV
# -> Connect to this project. Vercel fills these in automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Admin panel ---
# Your own Telegram numeric chat ID(s), comma-separated if more than one.
# Find yours by messaging your bot once, then checking the admin panel's
# user list, or by messaging @userinfobot on Telegram.
ADMIN_CHAT_IDS=123456789

# A long random secret that protects the /api/admin panel URL.
# Generate with: openssl rand -hex 24
ADMIN_PANEL_TOKEN=

# Optional: only needed if the auto-detected host is wrong (custom domain etc).
# APP_URL=https://your-project.vercel.app
